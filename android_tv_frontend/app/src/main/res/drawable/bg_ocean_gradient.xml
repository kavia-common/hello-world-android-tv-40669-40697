<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ocean_background" />
        </shape>
    </item>

    <!-- Subtle top-to-bottom gradient for depth -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/ocean_grad_top"
                android:endColor="@color/ocean_grad_bottom"
                android:angle="270" />
        </shape>
    </item>
</layer-list>
