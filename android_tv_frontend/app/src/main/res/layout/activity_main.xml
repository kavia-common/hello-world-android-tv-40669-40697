<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ocean_gradient"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:paddingStart="48dp"
    android:paddingEnd="48dp"
    android:paddingTop="48dp"
    android:paddingBottom="48dp">

    <!-- Centered 'Hello World' -->
    <TextView
        android:id="@+id/title_text"
        style="@style/HelloHeroText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello World"
        android:importantForAccessibility="yes"
        android:nextFocusDown="@id/subtitle_text"
        android:nextFocusUp="@id/subtitle_text"
        android:nextFocusLeft="@id/title_text"
        android:nextFocusRight="@id/title_text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtitle / helper text -->
    <TextView
        android:id="@+id/subtitle_text"
        style="@style/HelloSubtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ocean Professional • Modern retro-inspired"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/title_text"
        app:layout_constraintStart_toStartOf="@id/title_text"
        app:layout_constraintEnd_toEndOf="@id/title_text" />
</androidx.constraintlayout.widget.ConstraintLayout>
