<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 26+ override to enable default focus highlight -->
    <style name="AppTheme" parent="Theme.Leanback">
        <!-- Colors -->
        <item name="android:colorPrimary">@color/ocean_primary</item>
        <item name="android:colorAccent">@color/ocean_secondary</item>
        <item name="android:textColorPrimary">@color/ocean_text</item>

        <!-- Background -->
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@drawable/bg_ocean_gradient</item>

        <!-- Typography and TV sizing -->
        <item name="android:textViewStyle">@style/OceanTextView</item>

        <!-- Focus visuals (safe on API 26+) -->
        <item name="android:defaultFocusHighlightEnabled">true</item>
    </style>

    <style name="OceanTextView" parent="@android:style/Widget.TextView">
        <item name="android:textColor">@color/ocean_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:shadowColor">#1A000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">4</item>
    </style>

    <style name="HelloHeroText">
        <item name="android:textSize">56sp</item>
        <item name="android:textColor">@color/ocean_primary</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="HelloSubtitleText">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/tv_secondary</item>
    </style>
</resources>
